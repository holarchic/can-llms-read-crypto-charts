# Required
ANTHROPIC_API_KEY=sk-ant-...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...       # signal alerts
DISCORD_REPORTS_WEBHOOK_URL=https://discord.com/api/webhooks/... # backtest/report delivery

# Execution (optional — omit to run in alert-only mode)
EXECUTION_ENABLED=false
EXECUTION_MODE=testnet                                          # testnet | live
DISCORD_EXECUTION_WEBHOOK_URL=https://discord.com/api/webhooks/... # execution alerts

# Exchange credentials (optional — prefer GCP Secret Manager in production)
HL_PRIVATE_KEY=0x...                                            # HyperLiquid API key
HL_WALLET_ADDRESS=0x...                                         # HyperLiquid wallet

# GCP (optional — for Secret Manager and kill switch)
GCP_PROJECT_ID=
